{
  "name": "motion-levels-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/playground",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:games": "tsx scripts/validate-games.ts",
    "create:game": "tsx scripts/create-game.ts",
    "test:scaffold": "tsx scripts/test-create-game.ts",
    "playtest": "tsx scripts/playtest-games.ts",
    "check": "npm run validate:games && npm run typecheck && npm test && npm run test:scaffold && npm run build && npm run playtest"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
