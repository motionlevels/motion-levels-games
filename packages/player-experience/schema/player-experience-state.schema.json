{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionlevels.com/contracts/player-experience-state-v1.schema.json",
  "title": "Motion Levels Player Experience State v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contractVersion", "revision", "runId", "lifecycle", "allowedControls",
    "currentGame", "venueSessionId", "sessionId", "label", "phase",
    "difficulty", "teamName", "playerCount", "players", "score", "lives",
    "music", "musicVolume", "audioEnabled", "audioMuted", "paused", "success",
    "startedUnix", "endsUnix", "elapsedMillis", "remainingMillis",
    "introRemainingMillis", "countdownRemainingMillis", "activeTargets",
    "lastEventUnixNanos", "lastEventCue", "lastEventMessage", "lastPressureUnix",
    "catalog"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string" },
    "lifecycle": { "enum": ["idle", "launching", "waiting", "starting", "running", "paused", "finished", "stopping", "error"] },
    "allowedControls": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["pause", "resume", "restart", "exit", "narration", "stop_narration", "mute", "unmute", "toggle_mute", "recording_retry", "recording_continue_without", "recording_cancel"] }
    },
    "currentGame": { "type": "string", "minLength": 1 },
    "venueSessionId": { "type": "string" },
    "sessionId": { "type": "string" },
    "label": { "type": "string" },
    "phase": { "type": "string" },
    "difficulty": { "type": "string" },
    "teamName": { "type": "string" },
    "playerCount": { "type": "integer", "minimum": 0 },
    "players": { "type": "array", "items": { "$ref": "#/$defs/player" } },
    "score": { "type": "integer" },
    "lives": { "type": "integer" },
    "music": { "type": "string" },
    "musicVolume": { "type": "number" },
    "sound": { "type": "string" },
    "soundVolume": { "type": "number", "minimum": 0, "maximum": 1 },
    "soundPlaybackRate": { "type": "number", "minimum": 0.75, "maximum": 1.25 },
    "narration": { "type": "string" },
    "narrationVolume": { "type": "number", "minimum": 0, "maximum": 1 },
    "narrationSequence": { "type": "integer", "minimum": 0 },
    "narrationDurationMillis": { "type": "integer", "minimum": 0 },
    "narrationRemainingMillis": { "type": "integer", "minimum": 0 },
    "narrationStopSequence": { "type": "integer", "minimum": 0 },
    "audioEnabled": { "type": "boolean" },
    "audioMuted": { "type": "boolean" },
    "audioOutputState": { "enum": ["disabled", "checking", "ready", "suspended", "failed"] },
    "outputTest": {
      "type": ["object", "null"],
      "required": ["id", "target", "state", "sequence", "startedUnixMillis"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "target": { "enum": ["floor", "audio"] },
        "state": { "enum": ["idle", "pending", "playing", "passed", "failed"] },
        "sequence": { "type": "integer", "minimum": 1 },
        "startedUnixMillis": { "type": "integer", "minimum": 0 },
        "finishedUnixMillis": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "paused": { "type": "boolean" },
    "success": { "type": "boolean" },
    "startedUnix": { "type": "integer" },
    "endsUnix": { "type": "integer" },
    "elapsedMillis": { "type": "integer", "minimum": 0 },
    "remainingMillis": { "type": "integer", "minimum": 0 },
    "introRemainingMillis": { "type": "integer", "minimum": 0 },
    "countdownRemainingMillis": { "type": "integer", "minimum": 0 },
    "activeTargets": { "type": "integer", "minimum": 0 },
    "lastEventUnixNanos": { "type": "integer" },
    "lastEventSequence": { "type": "integer", "minimum": 0 },
    "lastEventCue": { "type": "string" },
    "lastEventMessage": { "type": "string" },
    "lastPressureUnix": { "type": "integer" },
    "recordingGate": { "$ref": "#/$defs/recordingGate" },
    "catalog": { "type": "array" }
  },
  "$defs": {
    "recordingGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "state", "scope", "runId", "captureId", "attempt",
        "startedAtUnixMillis", "timeoutAtUnixMillis"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["arming", "timed_out", "ready"] },
        "scope": { "const": "run" },
        "runId": { "type": "string", "minLength": 1 },
        "captureId": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "startedAtUnixMillis": { "type": "integer", "minimum": 0 },
        "timeoutAtUnixMillis": { "type": "integer", "minimum": 0 },
        "readyAtUnixMillis": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["timeout", "unavailable", "start_rejected", "start_unconfirmed"] }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "color", "score", "lives"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": ["r", "g", "b"],
          "properties": {
            "r": { "type": "integer", "minimum": 0, "maximum": 255 },
            "g": { "type": "integer", "minimum": 0, "maximum": 255 },
            "b": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "score": { "type": "integer" },
        "lives": { "type": "integer" }
      }
    }
  }
}
